<?xml version="1.0" encoding="utf-8"?>
<!--
  Plug-in ESAPI (.esapi.dll) que atribui o usuario logado como proprietario das
  atividades de Care Path do ARIA (Documentacao, Aprovacao Fisica, Preparacao PD,
  Execucao PD, Analise PD).

  NAO grava no paciente: nao precisa de [assembly: ESAPIScript(IsWriteable=true)].
  O ESAPI e usado somente para ler context.CurrentUser; a atribuicao e feita por
  UI Automation sobre a janela do ARIA.

  Pre-requisitos:
    1. Copie as 2 DLLs da Varian para .\lib (a partir do GAC do servidor).
    2. Compile com o MSBuild do .NET Framework:
         C:\Windows\Microsoft.NET\Framework64\v4.0.30319\MSBuild.exe ^
             Proprietario_Tarefas.csproj /p:Configuration=Release
       Sem MSBuild, o csc direto tambem serve (ver README).
    3. Saida: .\bin\Release\AriaTarefasV1_0.esapi.dll

  Ao publicar uma versao nova, troque o AssemblyName (V1_1, V1_2...) — senao a
  Eclipse pode continuar carregando a DLL antiga em cache.
-->
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Library</OutputType>
    <RootNamespace>VMS.TPS</RootNamespace>
    <!-- Nome termina em .esapi para a Eclipse reconhecer o plug-in. -->
    <AssemblyName>AriaTarefasV2_8.esapi</AssemblyName>
    <TargetFrameworkVersion>v4.5.2</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Fontes em UTF-8 sem BOM (convencao do repo): sem isto o csc le como ANSI. -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- DLLs da Varian (copiadas para .\lib a partir do GAC do servidor) -->
    <Reference Include="VMS.TPS.Common.Model.API">
      <HintPath>..\..\lib\VMS.TPS.Common.Model.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VMS.TPS.Common.Model.Types">
      <HintPath>..\..\lib\VMS.TPS.Common.Model.Types.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Framework -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />

    <!-- UI Automation: automacao da janela do ARIA -->
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />

    <!-- WPF: System.Windows.MessageBox -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Proprietario_Tarefas_Core.cs" />
    <Compile Include="Proprietario_Tarefas.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
